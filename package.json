{
  "name": "getmattered-mcp",
  "version": "1.20.0",
  "description": "Job search and auto apply MCP server for ChatGPT, Claude, Cursor and any MCP client. Auto-Apply That Ends on an Interview: matched jobs, applications sent on the employer's own site, tailored resumes, cover letters, interview prep and an application tracker.",
  "type": "module",
  "bin": {
    "getmattered-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "server.json",
    "CHANGELOG.md",
    "plugins"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "package:openai": "node scripts/openai-package.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "ai-job-search",
    "ats",
    "auto-apply",
    "auto-apply-jobs",
    "career",
    "chatgpt",
    "claude",
    "claude-code",
    "claude-desktop",
    "cli",
    "cover-letter",
    "cursor",
    "getmattered",
    "interview-prep",
    "job-application",
    "job-application-tracker",
    "job-search",
    "job-search-mcp",
    "job-tracker",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "remote-mcp",
    "resume",
    "resume-tailoring",
    "vscode",
    "windsurf"
  ],
  "author": "GetMattered <ava@getmattered.com>",
  "license": "MIT",
  "homepage": "https://getmattered.com/mcps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmattered/getmattered-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/getmattered/getmattered-mcp/issues",
    "email": "support@getmattered.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "mcpName": "com.getmattered/getmattered"
}
